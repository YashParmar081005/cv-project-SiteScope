# Copy to .env and adjust. Never commit .env.
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

# MongoDB (docker compose uses mongodb://mongo:27017)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sitescope

# Auth — JWT_SECRET is REQUIRED in production (>= 32 random characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
COOKIE_SECURE=false            # true when served over HTTPS
ALLOW_REGISTRATION=true        # self sign-up; set false to let only admins create users
PASSWORD_ITERATIONS=600000

# First administrator, created at startup only if no admin exists yet
ADMIN_EMAIL=admin@sitescope.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Uploads & storage (images live on disk / object storage, never in MongoDB)
MAX_UPLOAD_MB=15
# STORAGE_DIR=./data/storage

